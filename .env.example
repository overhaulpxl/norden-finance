# Database connection strings
# DATABASE_URL: Runtime pooled connection string for Serverless execution (e.g. Supavisor/PgBouncer port 6543)
DATABASE_URL=
# DIRECT_URL: Direct session connection string for Prisma migrations (e.g. PostgreSQL direct port 5432)
# For local development with a single standalone database, set both to the same local connection string.
DIRECT_URL=

NEXT_PUBLIC_APP_URL=https://nordenfinance.site

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Preferred Firebase Admin names for production hosting.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Backward-compatible local names also work.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

GEMINI_API_KEY=

# At least 32 random characters. Used by /api/cron/recurring and /api/cron/reminders.
CRON_SECRET=

# Preferred secret for signed Mobile Shortcuts/NFC URLs. Falls back to CRON_SECRET if empty.
SHORTCUT_TOKEN_SECRET=

# Email Verification Provider (firebase or resend)
# Default is firebase. Resend verification requires a verified custom domain.
# onboarding@resend.dev is only for the owner email and is not suitable for public users.
EMAIL_VERIFICATION_PROVIDER=firebase

# Resend email delivery for reminder emails.
RESEND_API_KEY=
EMAIL_FROM=Norden Finance <onboarding@resend.dev>
ADMIN_EMAIL=
SUPPORT_EMAIL=

# Storage Provider (Supabase Storage)
STORAGE_PROVIDER=supabase
# Supabase URL and server-side secret key for private/public storage operations
SUPABASE_URL=https://cfsjmpfgywfvpmrguqsi.supabase.co
# Server-side service key (never expose to client or prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
# Backward-compatible alias
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Console requirement:
# Authentication -> Settings -> Authorized domains -> add nordenfinance.site
# Keep nordenfinance.vercel.app during migration until Hostinger production is verified.
